# AI Microservice Environment Configuration
PORT=8001
HOST=0.0.0.0
DEBUG=true

# ==============================================================================
# OpenRouter Unified Multi-Model Provider (Single API Key for all LLM Families)
# API URL: https://openrouter.ai/api/v1
# Obtain key at: https://openrouter.ai/keys
# ==============================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://ubp.pookal.local
OPENROUTER_APP_NAME="UBP AI Intelligence Engine"

# Default Provider: "openrouter" (recommended), "gemini", "openai", or "mock"
DEFAULT_AI_PROVIDER=openrouter

# OpenRouter Task Model Routing:
# Available Free Models:
# - Meta: meta-llama/llama-3.3-70b-instruct:free, meta-llama/llama-3.1-8b-instruct:free, meta-llama/llama-3.2-11b-vision-instruct:free
# - Google: google/gemini-2.0-flash-exp:free, google/gemini-2.0-flash-thinking-exp:free
# - DeepSeek: deepseek/deepseek-r1:free, deepseek/deepseek-chat:free
# - Mistral: mistralai/mistral-7b-instruct:free, mistralai/mistral-small-3:free
# - Qwen: qwen/qwen-2.5-coder-32b-instruct:free, qwen/qwen-2.5-72b-instruct:free
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_COPILOT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1:free
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Fallback Chains (Comma-separated list; automatically fail over if primary is rate-limited or busy)
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,mistralai/mistral-7b-instruct:free,qwen/qwen-2.5-coder-32b-instruct:free,deepseek/deepseek-r1:free
OPENROUTER_COPILOT_FALLBACKS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free,mistralai/mistral-7b-instruct:free,deepseek/deepseek-r1:free
OPENROUTER_VISION_FALLBACKS=google/gemini-2.0-flash-exp:free,meta-llama/llama-3.2-11b-vision-instruct:free,openai/gpt-4o-mini

# ==============================================================================
# Legacy / Direct Model Providers (Optional direct fallback)
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

